		"vitest": "catalog:"
	},
	"peerDependencies": {
		"ts-morph": ">=28.0.0"
	},
	"peerDependenciesMeta": {
		"ts-morph": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=20"
	}
