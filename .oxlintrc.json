{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"env": {
		"node": true
	},
	"ignorePatterns": [
		"dist/**",
		"coverage/**",
		"**/.wrangler/**",
		"**/.honey/**",
		"**/.cache/**",
		"**/_gen/**",
		"**/test-results/**",
		"**/playwright-report/**",
		".agents/**",
		".claude/**",
		".codex/**",
		".gemini/**",
		".grok/**",
		".rulesync/**",
		"packages/core/_v0/**"
	],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		"no-unused-vars": "warn",
		"unicorn/no-array-sort": "off",
		"unicorn/prefer-string-starts-ends-with": "warn"
	},
	"overrides": [
		{
			"files": [
				"**/*.{test,typetest}.ts",
				"packages/core/tests/**/*.ts",
				"packages/core/tests/e2e/**/*.ts",
				"bench/**/*.ts"
			],
			"rules": {
				"typescript/no-explicit-any": "off"
			}
		}
	]
}
