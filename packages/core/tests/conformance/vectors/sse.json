{
	"$comment": "SDK runtime SSE parsing (WHATWG event stream interpretation). `chunks` are delivered in order as UTF-8; `events` are the dispatched events. `id` is the sticky last event ID, omitted while empty. An event still open at end of stream is never dispatched.",
	"vectors": [
		{ "name": "single event", "chunks": ["data: hello\n\n"], "events": [{ "data": "hello" }] },
		{ "name": "multi-line data", "chunks": ["data: a\ndata: b\n\n"], "events": [{ "data": "a\nb" }] },
		{ "name": "CRLF line endings", "chunks": ["data: a\r\n\r\n"], "events": [{ "data": "a" }] },
		{
			"name": "CR-only line endings",
			"chunks": ["data: a\r\rdata: b\r\r"],
			"events": [{ "data": "a" }, { "data": "b" }]
		},
		{ "name": "CRLF split across chunks", "chunks": ["data: a\r", "\n\r", "\n"], "events": [{ "data": "a" }] },
		{
			"name": "mixed endings do not merge events",
			"chunks": ["data: a\n\ndata: b\r\n\r\n"],
			"events": [{ "data": "a" }, { "data": "b" }]
		},
		{ "name": "event type", "chunks": ["event: ping\ndata: 1\n\n"], "events": [{ "data": "1", "event": "ping" }] },
		{
			"name": "id is sticky",
			"chunks": ["id: 7\ndata: a\n\ndata: b\n\n"],
			"events": [
				{ "data": "a", "id": "7" },
				{ "data": "b", "id": "7" }
			]
		},
		{
			"name": "empty id resets",
			"chunks": ["id: 7\ndata: a\n\nid:\ndata: b\n\n"],
			"events": [{ "data": "a", "id": "7" }, { "data": "b" }]
		},
		{
			"name": "id with NUL ignored",
			"chunks": ["id: 1\ndata: a\n\nid: x\u0000y\ndata: b\n\n"],
			"events": [
				{ "data": "a", "id": "1" },
				{ "data": "b", "id": "1" }
			]
		},
		{
			"name": "retry digits only",
			"chunks": ["retry: 3000\ndata: a\n\nretry: 0x10\ndata: b\n\nretry:\ndata: c\n\n"],
			"events": [{ "data": "a", "retry": 3000 }, { "data": "b" }, { "data": "c" }]
		},
		{ "name": "comment lines ignored", "chunks": [": keepalive\n\ndata: a\n\n"], "events": [{ "data": "a" }] },
		{ "name": "no space after colon", "chunks": ["data:a\n\n"], "events": [{ "data": "a" }] },
		{ "name": "only first space stripped", "chunks": ["data:  a \n\n"], "events": [{ "data": " a " }] },
		{ "name": "trailing spaces kept", "chunks": ["data: hello \n\n"], "events": [{ "data": "hello " }] },
		{ "name": "empty data dispatches empty string", "chunks": ["data:\n\n"], "events": [{ "data": "" }] },
		{ "name": "no data, no event", "chunks": ["event: x\n\n"], "events": [] },
		{ "name": "BOM stripped", "chunks": ["﻿data: a\n\n"], "events": [{ "data": "a" }] },
		{
			"name": "U+2028 is not a line break",
			"chunks": ["data: {\"t\":\"a event: admin id: 9\"}\n\n"],
			"events": [{ "data": "{\"t\":\"a event: admin id: 9\"}" }]
		},
		{ "name": "truncated final event discarded", "chunks": ["data: a\n\ndata: partial"], "events": [{ "data": "a" }] },
		{
			"name": "truncated final event with newline discarded",
			"chunks": ["data: a\n\ndata: partial\n"],
			"events": [{ "data": "a" }]
		},
		{ "name": "unknown field ignored", "chunks": ["foo: bar\ndata: a\n\n"], "events": [{ "data": "a" }] },
		{ "name": "field without colon", "chunks": ["data\n\n"], "events": [{ "data": "" }] },
		{
			"name": "multibyte UTF-8 split across chunks",
			"chunks": [{ "bytes": [100, 97, 116, 97, 58, 32, 240, 159] }, { "bytes": [141, 175, 10, 10] }],
			"events": [{ "data": "🍯" }]
		}
	]
}
