{
	"name": "@lovrozagar/honey",
	"version": "0.3.0",
	"description": "Type-safe API framework built on Web Standards. Builder-pattern DX, precompiled radix tree in production.",
	"keywords": [
		"api",
		"framework",
		"honey",
		"radix-tree",
		"router",
		"type-safe",
		"web-standards"
	],
	"homepage": "https://github.com/lovrozagar/honey#readme",
	"bugs": {
		"url": "https://github.com/lovrozagar/honey/issues"
	},
	"license": "MIT",
	"author": "lovrozagar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lovrozagar/honey.git",
		"directory": "packages/core"
	},
	"bin": {
		"honey": "./src/cli.ts"
	},
	"files": [
		"dist",
		"docs",
		"src"
	],
	"type": "module",
	"sideEffects": [
		"./src/i18n.ts",
		"./src/openapi/register.ts",
		"./src/serve-register.ts"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		},
		"./accepts": {
			"types": "./dist/accepts.d.ts",
			"default": "./src/accepts.ts"
		},
		"./body-limit": {
			"types": "./dist/body-limit.d.ts",
			"default": "./src/body-limit.ts"
		},
		"./build": {
			"types": "./dist/build/index.d.ts",
			"default": "./src/build/index.ts"
		},
		"./cli": {
			"types": "./dist/cli.d.ts",
			"default": "./src/cli.ts"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"default": "./src/client/index.ts"
		},
		"./client/sdk": {
			"types": "./dist/client/sdk.d.ts",
			"default": "./src/client/sdk.ts"
		},
		"./codegen": {
			"types": "./dist/codegen.d.ts",
			"default": "./src/codegen.ts"
		},
		"./codegen-go-cli": {
			"types": "./dist/codegen-go-cli.d.ts",
			"default": "./src/codegen-go-cli.ts"
		},
		"./codegen/extract": {
			"types": "./dist/type-extractor.d.ts",
			"default": "./src/type-extractor.ts"
		},
		"./cookie": {
			"types": "./dist/cookie.d.ts",
			"default": "./src/cookie.ts"
		},
		"./cookie-sign": {
			"types": "./dist/cookie-sign.d.ts",
			"default": "./src/cookie-sign.ts"
		},
		"./cors": {
			"types": "./dist/cors.d.ts",
			"default": "./src/cors.ts"
		},
		"./crypto": {
			"types": "./dist/crypto.d.ts",
			"default": "./src/crypto.ts"
		},
		"./curl-logger": {
			"types": "./dist/curl-logger.d.ts",
			"default": "./src/curl-logger.ts"
		},
		"./csrf": {
			"types": "./dist/csrf.d.ts",
			"default": "./src/csrf.ts"
		},
		"./errors": {
			"types": "./dist/errors.d.ts",
			"default": "./src/errors.ts"
		},
		"./etag": {
			"types": "./dist/etag.d.ts",
			"default": "./src/etag.ts"
		},
		"./i18n": {
			"types": "./dist/i18n.d.ts",
			"default": "./src/i18n.ts"
		},
		"./input": {
			"types": "./dist/input.d.ts",
			"default": "./src/input.ts"
		},
		"./ip-restrict": {
			"types": "./dist/ip-restrict.d.ts",
			"default": "./src/ip-restrict.ts"
		},
		"./logger": {
			"types": "./dist/logger.d.ts",
			"default": "./src/logger.ts"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"default": "./src/node.ts"
		},
		"./openapi": {
			"types": "./dist/openapi/register.d.ts",
			"default": "./src/openapi/register.ts"
		},
		"./openapi/spec": {
			"types": "./dist/openapi/spec.d.ts",
			"default": "./src/openapi/spec.ts"
		},
		"./openapi/scalar": {
			"types": "./dist/openapi/scalar.d.ts",
			"default": "./src/openapi/scalar.ts"
		},
		"./openapi/swagger": {
			"types": "./dist/openapi/swagger.d.ts",
			"default": "./src/openapi/swagger.ts"
		},
		"./plugin": {
			"types": "./dist/plugin.d.ts",
			"default": "./src/plugin.ts"
		},
		"./powered-by": {
			"types": "./dist/powered-by.d.ts",
			"default": "./src/powered-by.ts"
		},
		"./pretty-json": {
			"types": "./dist/pretty-json.d.ts",
			"default": "./src/pretty-json.ts"
		},
		"./proxy": {
			"types": "./dist/proxy.d.ts",
			"default": "./src/proxy.ts"
		},
		"./request-to-curl": {
			"types": "./dist/request-to-curl.d.ts",
			"default": "./src/request-to-curl.ts"
		},
		"./request-id": {
			"types": "./dist/request-id.d.ts",
			"default": "./src/request-id.ts"
		},
		"./secure-headers": {
			"types": "./dist/secure-headers.d.ts",
			"default": "./src/secure-headers.ts"
		},
		"./serve": {
			"types": "./dist/serve-register.d.ts",
			"default": "./src/serve-register.ts"
		},
		"./server-timing": {
			"types": "./dist/server-timing.d.ts",
			"default": "./src/server-timing.ts"
		},
		"./static": {
			"types": "./dist/static.d.ts",
			"default": "./src/static.ts"
		},
		"./telemetry/otel": {
			"types": "./dist/telemetry/otel.d.ts",
			"default": "./src/telemetry/otel.ts"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"default": "./src/testing.ts"
		},
		"./timeout": {
			"types": "./dist/timeout.d.ts",
			"default": "./src/timeout.ts"
		},
		"./tree": {
			"types": "./dist/tree.d.ts",
			"default": "./src/tree.ts"
		},
		"./ws/bun": {
			"types": "./dist/ws/bun.d.ts",
			"default": "./src/ws/bun.ts"
		},
		"./ws/cloudflare": {
			"types": "./dist/ws/cloudflare.d.ts",
			"default": "./src/ws/cloudflare.ts"
		},
		"./ws/deno": {
			"types": "./dist/ws/deno.d.ts",
			"default": "./src/ws/deno.ts"
		},
		"./ws/node": {
			"types": "./dist/ws/node.d.ts",
			"default": "./src/ws/node.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build:types": "tsc -p tsconfig.dts.json",
		"prepack": "tsc -p tsconfig.dts.json",
		"test": "vitest run",
		"test:all": "vitest run --config vitest.all.config.ts",
		"test:harness": "vitest run --config vitest.harness.config.ts",
		"test:harness:rust": "vitest run --config vitest.harness.rust.config.ts",
		"test:watch": "vitest",
		"type:check": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.types.json",
		"type:check:tests": "NODE_OPTIONS='--max-old-space-size=4096' tsc --noEmit",
		"type:check:types": "tsc --noEmit -p tsconfig.types.json"
	},
	"dependencies": {
		"jiti": "2.7.0"
	},
	"devDependencies": {
		"@honey/e2e-kitchen": "workspace:*",
		"@honey/e2e-surface": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@total-typescript/ts-reset": "catalog:",
		"@types/node": "catalog:",
		"@types/ws": "catalog:",
		"arktype": "catalog:",
		"effect": "catalog:",
		"ts-morph": "catalog:",
		"typescript": "catalog:",
		"valibot": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"yup": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"ts-morph": ">=25.0.0"
	},
	"peerDependenciesMeta": {
		"ts-morph": {
			"optional": true
		}
	}
}
