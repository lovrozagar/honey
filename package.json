{
	"name": "honey-monorepo",
	"version": "0.1.1",
	"private": true,
	"workspaces": {
		"packages": [
			"_v0",
			"packages/gen",
			"packages/core/tests/e2e/*",
			"packages/core/tests/e2e/apps/*",
			"bench"
		],
		"catalog": {
			"@cloudflare/workers-types": "5.20260710.1",
			"@playwright/test": "1.61.1",
			"@total-typescript/ts-reset": "0.6.1",
			"@types/node": "26.1.1",
			"@types/ws": "8.18.1",
			"arktype": "2.2.3",
			"bun-types": "1.3.14",
			"effect": "3.21.4",
			"hono": "4.12.29",
			"ts-morph": "28.0.0",
			"tsx": "4.23.0",
			"typescript": "7.0.2",
			"valibot": "1.4.2",
			"vite": "8.1.4",
			"vitest": "4.1.10",
			"wrangler": "4.110.0",
			"ws": "8.21.0",
			"yup": "1.7.1",
			"zod": "4.3.6"
		}
	},
	"type": "module",
	"scripts": {
		"bench:finalize": "bun bench/src/finalize.ts",
		"bench:hotpath": "bun bench/src/hotpath.ts",
		"deploy:e2e:cf": "bun run --filter @honey/e2e-cf-workers deploy",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"generate": "bun --bun run --filter './packages/core/tests/e2e/apps/*' generate",
		"grunt:antigravity": "antigravity --dangerously-skip-permissions",
		"grunt:claude": "claude --dangerously-skip-permissions",
		"grunt:codex": "codex --dangerously-bypass-approvals-and-sandbox",
		"grunt:doctor": "node ./.rulesync/scripts/doctor.mjs",
		"grunt:gemini": "gemini --yolo",
		"grunt:grok": "grok --yolo",
		"grunt:hooks:check": "node .rulesync/scripts/hooks-union.mjs --check",
		"grunt:hooks:union": "node .rulesync/scripts/hooks-union.mjs",
		"grunt:purge:global-mcps": "node .rulesync/scripts/purge-global-mcps.mjs",
		"grunt:purge:global-mcps:apply": "node .rulesync/scripts/purge-global-mcps.mjs --apply",
		"grunt:rulesync:check": "node ./.rulesync/scripts/guarded-roots.mjs check",
		"grunt:rulesync:doctor": "rulesync doctor",
		"grunt:rulesync:generate": "node ./.rulesync/scripts/guarded-roots.mjs generate",
		"grunt:rulesync:watch": "node ./.rulesync/scripts/guarded-roots.mjs watch",
		"grunt:setup": "node ./.rulesync/scripts/setup.mjs",
		"grunt:sync:globals": "node .rulesync/scripts/sync-global-settings.mjs",
		"grunt:sync:globals:apply": "node .rulesync/scripts/sync-global-settings.mjs --apply",
		"grunt:sync:globals:check": "node .rulesync/scripts/check-globals.mjs",
		"grunt:test:e2e": "vitest run -c vitest.e2e.config.ts",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepare": "git config --get core.hooksPath >/dev/null || git config core.hooksPath .githooks || true",
		"readme:sync": "bun _v0/scripts/sync-readme.ts",
		"test": "bun run test:v0; v0=$?; bun run test:v1; v1=$?; bun run test:gen; gen=$?; bun run test:bench; bench=$?; exit $((v0 | v1 | gen | bench))",
		"test:all": "bun run --filter @lovrozagar/honey test:all",
		"test:bench": "bun run --filter @honey/bench test",
		"test:build": "bun packages/core/tests/e2e/run-build.ts",
		"test:build:all": "bun packages/core/tests/e2e/run-build.ts --runtime all",
		"test:build:bun": "bun packages/core/tests/e2e/run-build.ts --runtime bun",
		"test:build:ci": "bun packages/core/tests/e2e/run-build.ts --runtime all --check-generated",
		"test:consumers": "bun test packages/core/tests/e2e/apps/kitchen/tests/smoke.test.ts packages/core/tests/e2e/apps/defaults/tests/smoke.test.ts packages/core/tests/e2e/apps/compose/tests/smoke.test.ts packages/core/tests/e2e/apps/surface/tests/smoke.test.ts packages/core/tests/e2e/apps/gateway/tests/smoke.test.ts",
		"test:e2e": "bun packages/core/tests/e2e/run.ts --env bun",
		"test:e2e:all": "bun packages/core/tests/e2e/run.ts --env all",
		"test:e2e:cf": "bun packages/core/tests/e2e/run.ts --env cf",
		"test:e2e:node": "bun packages/core/tests/e2e/run.ts --env node",
		"test:gen": "bun run --filter @lovrozagar/honey-codegen test",
		"test:harness": "bun run --filter @lovrozagar/honey test:harness",
		"test:harness:rust": "bun run --filter @lovrozagar/honey test:harness:rust",
		"test:live:cf": "bun run --filter @honey/e2e-cf-workers test:live",
		"test:packaging": "bun packages/core/tests/e2e/run-strict-consumer.ts",
		"test:v0": "HONEY_ORACLE=1 bun run --filter @lovrozagar/honey test",
		"test:v1": "cd packages/core && vitest run --coverage",
		"test:watch": "bun run --filter @lovrozagar/honey test:watch",
		"typecheck": "bun run --filter @lovrozagar/honey type:check && tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/gen/tsconfig.json && tsc --noEmit -p bench/tsconfig.json",
		"typecheck:consumers": "bun run --filter './packages/core/tests/e2e/apps/*' type:check"
	},
	"devDependencies": {
		"@clack/prompts": "^0.11.0",
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"@lovrozagar/grunt": "0.11.0",
		"@total-typescript/ts-reset": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "4.1.10",
		"oxc-parser": "0.152.0",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"rulesync": "16.17.0",
		"smol-toml": "^1.8.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "bun@1.3.11"
}
