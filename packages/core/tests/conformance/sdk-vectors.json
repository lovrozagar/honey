{
	"$comment": "Shared SDK runtime conformance vectors. The Go, Python and Rust runtimes each run every vector (tests/integration/sdk-harness/polyglot-conformance.test.ts). See docs/sdk.md, 'Runtime behavior'.",
	"path": [
		{ "name": "plain", "template": "/users/{id}", "params": { "id": "42" }, "expect": "/users/42" },
		{
			"name": "reserved chars",
			"template": "/users/{id}",
			"params": { "id": "a b/c?d#e" },
			"expect": "/users/a%20b%2Fc%3Fd%23e"
		},
		{ "name": "non-ascii", "template": "/users/{id}", "params": { "id": "ü" }, "expect": "/users/%C3%BC" },
		{ "name": "unreserved kept", "template": "/users/{id}", "params": { "id": "-._~" }, "expect": "/users/-._~" },
		{ "name": "three dots allowed", "template": "/users/{id}", "params": { "id": "..." }, "expect": "/users/..." },
		{ "name": "dot-dot rejected", "template": "/users/{id}", "params": { "id": ".." }, "error": true },
		{ "name": "dot rejected", "template": "/users/{id}", "params": { "id": "." }, "error": true },
		{ "name": "empty rejected", "template": "/users/{id}", "params": { "id": "" }, "error": true },
		{ "name": "missing rejected", "template": "/users/{id}", "params": {}, "error": true },
		{
			"name": "hyphenated name",
			"template": "/a/{x}/b/{y-z}",
			"params": { "x": "1", "y-z": "2" },
			"expect": "/a/1/b/2"
		},
		{
			"name": "custom method suffix",
			"template": "/ops/{id}:cancel",
			"params": { "id": "7" },
			"expect": "/ops/7:cancel"
		},
		{ "name": "percent escaped", "template": "/f/{name}", "params": { "name": "100%" }, "expect": "/f/100%25" }
	],
	"url": [
		{
			"name": "root base",
			"base": "https://api.example.com",
			"path": "/users",
			"query": [],
			"expect": "https://api.example.com/users"
		},
		{
			"name": "base path kept",
			"base": "https://api.example.com/v1",
			"path": "/users",
			"query": [],
			"expect": "https://api.example.com/v1/users"
		},
		{
			"name": "base trailing slash",
			"base": "https://api.example.com/v1/",
			"path": "/users",
			"query": [],
			"expect": "https://api.example.com/v1/users"
		},
		{
			"name": "base query kept",
			"base": "https://api.example.com/v1?key=k",
			"path": "/users",
			"query": [["a", "1"]],
			"expect": "https://api.example.com/v1/users?key=k&a=1"
		},
		{
			"name": "query escaping",
			"base": "http://127.0.0.1:8080",
			"path": "/x",
			"query": [
				["q", "a b&c=d"],
				["tags", "x"],
				["tags", "y"],
				["e", ""],
				["ü", "é+"]
			],
			"expect": "http://127.0.0.1:8080/x?q=a%20b%26c%3Dd&tags=x&tags=y&e=&%C3%BC=%C3%A9%2B"
		},
		{
			"name": "escaped path kept",
			"base": "http://127.0.0.1:8080",
			"path": "/x/a%2Fb",
			"query": [],
			"expect": "http://127.0.0.1:8080/x/a%2Fb"
		}
	],
	"float": [
		[0.1, "0.1"],
		[100.0, "100"],
		[-2.5, "-2.5"],
		[1e21, "1e+21"],
		[1.5e-7, "1.5e-7"],
		[0.000001, "0.000001"],
		[0.000001234, "0.000001234"],
		[123456789012345680000.0, "123456789012345680000"],
		[1.7976931348623157e308, "1.7976931348623157e+308"],
		[5e-324, "5e-324"]
	],
	"sse": [
		{ "name": "basic", "chunks": ["data: hello\n\n"], "events": [{ "data": "hello" }] },
		{ "name": "multi-line data", "chunks": ["data: a\ndata: b\n\n"], "events": [{ "data": "a\nb" }] },
		{ "name": "crlf", "chunks": ["data: x\r\n\r\n"], "events": [{ "data": "x" }] },
		{ "name": "cr only", "chunks": ["data: x\r\rdata: y\r\r"], "events": [{ "data": "x" }, { "data": "y" }] },
		{ "name": "mixed endings", "chunks": ["data: a\n\r\ndata: b\r\n\n"], "events": [{ "data": "a" }, { "data": "b" }] },
		{ "name": "crlf split across chunks", "chunks": ["data: x\r", "\n\r\n"], "events": [{ "data": "x" }] },
		{
			"name": "byte-wise chunks",
			"chunks": ["d", "a", "t", "a", ":", " ", "o", "k", "\n", "\n"],
			"events": [{ "data": "ok" }]
		},
		{ "name": "truncated final event dropped", "chunks": ["data: a\n\ndata: trunc"], "events": [{ "data": "a" }] },
		{ "name": "comment and data-less event", "chunks": [": ping\n\nevent: x\n\n"], "events": [] },
		{
			"name": "sticky id",
			"chunks": ["id: 1\ndata: a\n\ndata: b\n\n"],
			"events": [
				{ "data": "a", "id": "1" },
				{ "data": "b", "id": "1" }
			]
		},
		{ "name": "id with nul ignored", "chunks": ["id: a\u0000b\ndata: x\n\n"], "events": [{ "data": "x" }] },
		{
			"name": "retry digits only",
			"chunks": ["retry: 1500\ndata: x\n\nretry: -5\ndata: y\n\nretry: 1e3\ndata: z\n\n"],
			"events": [{ "data": "x", "retry": 1500 }, { "data": "y" }, { "data": "z" }]
		},
		{
			"name": "one leading space stripped",
			"chunks": ["data:x\n\ndata:  two\n\n"],
			"events": [{ "data": "x" }, { "data": " two" }]
		},
		{ "name": "field without colon", "chunks": ["data\n\n"], "events": [{ "data": "" }] },
		{ "name": "bom stripped", "chunks": ["﻿data: x\n\n"], "events": [{ "data": "x" }] },
		{
			"name": "u2028 kept inside data",
			"chunks": ["data: {\"t\":\"a b\u0085c\"}\n\n"],
			"events": [{ "data": "{\"t\":\"a b\u0085c\"}" }]
		},
		{ "name": "event field", "chunks": ["event: up\ndata: 1\n\n"], "events": [{ "data": "1", "event": "up" }] },
		{ "name": "unknown field ignored", "chunks": ["foo: bar\ndata: x\n\n"], "events": [{ "data": "x" }] },
		{ "name": "trailing spaces kept", "chunks": ["data: hello \n\n"], "events": [{ "data": "hello " }] }
	]
}
