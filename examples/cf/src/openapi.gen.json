{
	"info": {
		"title": "Honey CF",
		"version": "0.1.0"
	},
	"openapi": "3.1.0",
	"paths": {
		"/product/{id}": {
			"get": {
				"parameters": [
					{
						"in": "path",
						"name": "id",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$schema": "https://json-schema.org/draft/2020-12/schema",
									"type": "object",
									"properties": {
										"name": {
											"type": "string"
										}
									},
									"required": ["name"],
									"additionalProperties": false
								}
							}
						},
						"description": "ok"
					},
					"404": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"error_key": {
											"enum": ["not_found"],
											"type": "string"
										},
										"message": {
											"type": "string"
										},
										"status": {
											"enum": [404],
											"type": "integer"
										},
										"success": {
											"const": false
										}
									},
									"required": ["error_key", "status", "success"],
									"type": "object"
								}
							}
						},
						"description": "not_found"
					},
					"500": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"error_key": {
											"enum": ["product_error"],
											"type": "string"
										},
										"message": {
											"type": "string"
										},
										"status": {
											"enum": [500],
											"type": "integer"
										},
										"success": {
											"const": false
										}
									},
									"required": ["error_key", "status", "success"],
									"type": "object"
								}
							}
						},
						"description": "product_error"
					}
				}
			}
		},
		"/crash": {
			"get": {
				"responses": {
					"500": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"error_key": {
											"enum": ["product_error"],
											"type": "string"
										},
										"message": {
											"type": "string"
										},
										"status": {
											"enum": [500],
											"type": "integer"
										},
										"success": {
											"const": false
										}
									},
									"required": ["error_key", "status", "success"],
									"type": "object"
								}
							}
						},
						"description": "product_error"
					}
				}
			}
		}
	}
}
