			const entryPath = self.#toColonParams(entry.path, entry.wildcard)
			let fn: (input?: Record<string, unknown>) => unknown
			if (entry.ws) {
				fn = (input?: Record<string, unknown>) => self.#connectWS(entry, entryPath, (input ?? {}) as _RequestOptions)
			} else if (entry.sse) {
				fn = (input?: Record<string, unknown>) => self.#requestSSE(entry, entryPath, (input ?? {}) as _RequestOptions)
			} else {
				fn = (input?: Record<string, unknown>) => self.#request(entry, input ?? {})
