{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 120,
	"useTabs": true,
	"semi": false,
	"singleQuote": false,
	"ignorePatterns": [
		"dist/**",
		"coverage/**",
		"**/.wrangler/**",
		"**/.honey/**",
		"**/.cache/**",
		"**/_gen/**",
		"**/test-results/**",
		"**/playwright-report/**",
		"*.lock",
	],
}
