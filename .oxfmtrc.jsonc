{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 120,
	"useTabs": true,
	"semi": false,
	"singleQuote": false,
	"ignorePatterns": [
		"dist/**",
		"coverage/**",
		"**/.wrangler/**",
		"**/.honey/**",
		"**/.cache/**",
		"**/_gen/**",
		"**/test-results/**",
		"**/playwright-report/**",
		"*.lock",
		/* Blueprint is hand-maintained design docs (the rewrite SSOT), not honey source — the fmt/lint/typecheck gate is for packages/**. */
		"blueprint/**",
		".tmp/**",
		/* Agent tooling is generated by its own sync, not honey source. */
		".agents/**",
		".claude/**",
		".codex/**",
		".gemini/**",
		".grok/**",
		".rulesync/**",
		".mcp.json",
	],
}
