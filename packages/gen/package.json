{
	"name": "@lovrozagar/honey-codegen",
	"version": "1.0.0",
	"description": "Generates SDKs (TypeScript, Go, Rust, Python, C#, Java), a CLI and an MCP server from any OpenAPI 3.x document.",
	"license": "MIT",
	"author": "lovrozagar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lovrozagar/honey.git",
		"directory": "packages/gen"
	},
	"bin": {
		"honey-codegen": "bin/honey-codegen.js"
	},
	"files": [
		"bin",
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"honey-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./cli": {
			"honey-source": "./src/cli.ts",
			"types": "./dist/cli.d.ts",
			"default": "./dist/cli.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"prepack": "bun scripts/build.ts",
		"test": "vitest run --coverage",
		"test:harness": "vitest run --mode harness",
		"type:check": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"jiti": "2.7.0"
	},
	"devDependencies": {
		"@total-typescript/ts-reset": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "4.1.10",
		"oxfmt": "0.63.0",
		"ts-morph": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"oxfmt": ">=0.63.0",
		"ts-morph": ">=28.0.0"
	},
	"peerDependenciesMeta": {
		"oxfmt": {
			"optional": true
		},
		"ts-morph": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
