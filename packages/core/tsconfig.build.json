{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"allowImportingTsExtensions": false,
		"declaration": true,
		"declarationMap": true,
		"noEmit": false,
		"outDir": "./dist",
		"rewriteRelativeImportExtensions": true,
		"rootDir": "./src",
		"sourceMap": true,
		"types": []
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/client-mcp/**"]
}
