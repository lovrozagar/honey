{
  "name": "honey-monorepo",
  "version": "0.1.1",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "e2e/*",
      "e2e/apps/*",
      "bench"
    ],
    "catalog": {
      "@cloudflare/workers-types": "5.20260710.1",
      "@playwright/test": "1.61.1",
      "@total-typescript/ts-reset": "0.6.1",
      "@types/node": "26.1.1",
      "@types/ws": "8.18.1",
      "arktype": "2.2.3",
      "bun-types": "1.3.14",
      "effect": "3.21.4",
      "hono": "4.12.29",
      "ts-morph": "28.0.0",
      "tsx": "4.23.0",
      "typescript": "7.0.2",
      "valibot": "1.4.2",
      "vite": "8.1.4",
      "vitest": "4.1.10",
      "wrangler": "4.110.0",
      "ws": "8.21.0",
      "yup": "1.7.1",
      "zod": "4.3.6"
    }
  },
  "type": "module",
  "scripts": {
    "bench:hotpath": "bun bench/src/hotpath.ts",
    "deploy:e2e:cf": "bun run --filter @honey/e2e-cf-workers deploy",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate": "bun --bun run --filter './e2e/apps/*' generate",
    "grunt:antigravity": "antigravity --dangerously-skip-permissions",
    "grunt:claude": "claude --dangerously-skip-permissions",
    "grunt:codex": "codex --dangerously-bypass-approvals-and-sandbox",
    "grunt:doctor": "node ./scripts/doctor.mjs",
    "grunt:gemini": "gemini --yolo",
    "grunt:grok": "grok --yolo",
    "grunt:hooks:check": "node scripts/hooks-union.mjs --check",
    "grunt:hooks:union": "node scripts/hooks-union.mjs",
    "grunt:purge:global-mcps": "node scripts/purge-global-mcps.mjs",
    "grunt:purge:global-mcps:apply": "node scripts/purge-global-mcps.mjs --apply",
    "grunt:rulesync:check": "node ./scripts/guarded-roots.mjs check",
    "grunt:rulesync:doctor": "rulesync doctor",
    "grunt:rulesync:generate": "node ./scripts/guarded-roots.mjs generate",
    "grunt:rulesync:watch": "node ./scripts/guarded-roots.mjs watch",
    "grunt:setup": "node ./scripts/setup.mjs",
    "grunt:sync:globals": "node scripts/sync-global-settings.mjs",
    "grunt:sync:globals:apply": "node scripts/sync-global-settings.mjs --apply",
    "grunt:sync:globals:check": "node scripts/check-globals.mjs",
    "grunt:test:e2e": "vitest run -c vitest.e2e.config.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "git config --get core.hooksPath >/dev/null || git config core.hooksPath .githooks || true",
    "readme:sync": "bun packages/core/scripts/sync-readme.ts",
    "test": "bun run --filter @lovrozagar/honey test",
    "test:all": "bun run --filter @lovrozagar/honey test:all",
    "test:build": "bun e2e/run-build.ts",
    "test:build:all": "bun e2e/run-build.ts --runtime all",
    "test:build:bun": "bun e2e/run-build.ts --runtime bun",
    "test:build:ci": "bun e2e/run-build.ts --runtime all --check-generated",
    "test:consumers": "bun test e2e/apps/kitchen/tests/smoke.test.ts e2e/apps/defaults/tests/smoke.test.ts e2e/apps/compose/tests/smoke.test.ts e2e/apps/surface/tests/smoke.test.ts e2e/apps/gateway/tests/smoke.test.ts",
    "test:e2e": "bun e2e/run.ts --env bun",
    "test:e2e:all": "bun e2e/run.ts --env all",
    "test:e2e:cf": "bun e2e/run.ts --env cf",
    "test:e2e:deno": "bun e2e/run.ts --env deno",
    "test:e2e:node": "bun e2e/run.ts --env node",
    "test:harness": "bun run --filter @lovrozagar/honey test:harness",
    "test:harness:rust": "bun run --filter @lovrozagar/honey test:harness:rust",
    "test:live:cf": "bun run --filter @honey/e2e-cf-workers test:live",
    "test:packaging": "bun e2e/run-strict-consumer.ts",
    "test:watch": "bun run --filter @lovrozagar/honey test:watch",
    "typecheck": "bun run --filter @lovrozagar/honey type:check",
    "typecheck:consumers": "bun run --filter './e2e/apps/*' type:check"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@lovrozagar/grunt": "0.10.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "rulesync": "16.17.0",
    "smol-toml": "^1.8.0"
  },
  "packageManager": "bun@1.3.11"
}
