			"errors": ["invalid_token", "expired_token"],
			"meta": {},
			"method": "GET",
			"middleware": ["anonymous", "anonymous"],
			"params": [],
			"path": "/feed",
			"input": {
				"search": {
					"vendor": "zod",
					"version": 1
				}
			}
		},
		{
			"errors": ["invalid_token", "expired_token", "forbidden"],
			"meta": {},
