{
	"openapi": "3.1.0",
	"info": { "title": "Go CRUD", "version": "1.0.0" },
	"components": {
		"schemas": {
			"User": {
				"type": "object",
				"required": ["id", "email", "name"],
				"properties": {
					"id": { "type": "string" },
					"email": { "type": "string" },
					"name": { "type": "string" }
				}
			},
			"UserCreateInput": {
				"type": "object",
				"required": ["email", "name"],
				"properties": {
					"email": { "type": "string" },
					"name": { "type": "string" }
				}
			},
			"UserPatchInput": {
				"type": "object",
				"properties": {
					"email": { "type": "string" },
					"name": { "type": "string" }
				}
			},
			"ErrorEnvelope": {
				"type": "object",
				"required": ["error_key", "fields", "message", "status", "status_key", "success"],
				"properties": {
					"error_key": { "type": "string" },
					"fields": {
						"type": "object",
						"additionalProperties": { "type": "array", "items": { "type": "string" } }
					},
					"message": { "type": "string" },
					"status": { "type": "integer" },
					"status_key": { "type": "string" },
					"success": { "const": false, "type": "boolean" }
				}
			}
		}
	},
	"paths": {
		"/users": {
			"get": {
				"operationId": "users.list",
				"summary": "List users",
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": { "type": "array", "items": { "$ref": "#/components/schemas/User" } }
							}
						}
					}
				}
			},
			"post": {
				"operationId": "users.create",
				"summary": "Create user",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/UserCreateInput" }
						}
					}
				},
				"responses": {
					"201": {
						"description": "Created",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/User" }
							}
						}
					},
					"400": {
						"description": "Bad Request",
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
						}
					},
					"422": {
						"description": "Validation Error",
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
						}
					}
				}
			}
		},
		"/users/{id}": {
			"get": {
				"operationId": "users.get",
				"summary": "Get user by id",
				"parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/User" } }
						}
					},
					"404": {
						"description": "Not Found",
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
						}
					}
				}
			},
			"patch": {
				"operationId": "users.update",
				"summary": "Patch user",
				"parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/UserPatchInput" }
						}
					}
				},
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/User" } }
						}
					},
					"400": {
						"description": "Bad Request",
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
						}
					},
					"404": {
						"description": "Not Found",
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
						}
					}
				}
			},
			"delete": {
				"operationId": "users.delete",
				"summary": "Delete user",
				"parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
				"responses": {
					"204": { "description": "No Content" },
					"404": {
						"description": "Not Found",
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
						}
					}
				}
			}
		}
	}
}
