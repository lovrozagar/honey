}

impl RealtimeResource {
	/// Subscribe to realtime updates
	pub async fn subscribe(&self, opts: &RealtimeSubscribeOpts) -> Result<TypedWebSocket, Error> {
		let url_path = "/realtime/subscribe".to_string();
		let mut query_str = String::new();
		if !query_str.is_empty() { query_str.push('&'); }
		query_str.push_str(&format!("{}={}", "channel", urlencoding::encode(&opts.channel)));
		if let Some(ref rt) = opts.reconnect_token {
			if !query_str.is_empty() { query_str.push('&'); }
			query_str.push_str(&format!("reconnect_token={}", urlencoding::encode(rt)));
		}
		let full_url = if query_str.is_empty() {
			format!("{}{}", self.client.cfg.base_url, url_path)
		} else {
			format!("{}{}?{}", self.client.cfg.base_url, url_path, query_str)
