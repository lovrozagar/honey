{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"customConditions": ["honey-source"],
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"types": ["node"]
	},
	"include": ["src/**/*"]
}
