{
	"openapi": "3.1.0",
	"info": { "title": "Rust Realtime", "version": "1.0.0" },
	"paths": {
		"/realtime/connect": {
			"get": {
				"operationId": "realtime.connect",
				"summary": "Connect to realtime channel",
				"x-websocket": true,
				"x-realtime": true,
				"parameters": [
					{
						"in": "query",
						"name": "channel",
						"required": true,
						"schema": { "type": "string" }
					},
					{
						"in": "query",
						"name": "reconnect_token",
						"required": false,
						"schema": { "type": "string" }
					}
				],
				"responses": {
					"101": {
						"description": "Switching Protocols"
					}
				}
			}
		},
		"/users": {
			"get": {
				"operationId": "users.list",
				"summary": "List users",
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": { "type": "array", "items": { "type": "string" } }
							}
						}
					}
				}
			}
		}
	}
}
