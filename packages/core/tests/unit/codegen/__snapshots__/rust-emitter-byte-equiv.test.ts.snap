			.map_err(|e| Error::Other(e.to_string()))?;
		if let Some(ref protos) = opts.protocols {
			if !protos.is_empty() {
				req.headers_mut().insert(
					"Sec-WebSocket-Protocol",
					protos.join(", ").parse().map_err(|e: tokio_tungstenite::tungstenite::http::header::InvalidHeaderValue| Error::Other(e.to_string()))?,
