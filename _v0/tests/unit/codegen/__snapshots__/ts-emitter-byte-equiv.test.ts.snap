		const childOf = (node: _ServiceMapNode, key: string): _ServiceMapNode | undefined =>
			Object.hasOwn(node, key) ? (node as Record<string, _ServiceMapNode>)[key] : undefined

		function makeNodeProxy(node: _ServiceMapNode, path: string[]): object {
			const actionCache = new Map<string, (input?: Record<string, unknown>) => unknown>()
			const childCache = new Map<string, object>()
			return new Proxy({} as Record<string, unknown>, {
				get: (target, key: string | symbol) => {
					if (typeof key === "symbol") return Reflect.get(target, key)
					const child = childOf(node, key)
					if (child === undefined) return Reflect.get(target, key)

					if (isEntry(child)) {
						const cached = actionCache.get(key)
						if (cached) return cached
						const fn = callable(child, [...path, key].join("."))
						actionCache.set(key, fn)
						return fn
					}

					const cachedChild = childCache.get(key)
					if (cachedChild) return cachedChild
					const childProxy = makeNodeProxy(child, [...path, key])
					childCache.set(key, childProxy)
