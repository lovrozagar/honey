{
	// the document serveStaticOpenApi serves in the kitchen app, committed under assets/
	"assets": {
		"binding": "ASSETS",
		"directory": "./assets",
		"run_worker_first": true,
	},
	"compatibility_date": "2026-01-20",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/worker.ts",
	"name": "honey-cf-e2e",
	"vars": {
		"HONEY_E2E_APP": "kitchen",
	},
	"workers_dev": true,
}
