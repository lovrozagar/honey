export class TestSDK<TThrow extends boolean = false> {
	state: Record<string, unknown>
	#config: TestSDKConfig<TThrow>
	#fetchFn: typeof fetch
	#resourceCache = new Map<string, Record<string, unknown>>()
	#searchSerializer: (query: Record<string, unknown>) => URLSearchParams
	#staleTime: number
	#staleUntil: Map<string, _StaleEntry> | null
	#stalePatterns = new Map<string, Map<string, _StaleEntry>>()
	#patternRegexCache = new Map<string, RegExp>()
